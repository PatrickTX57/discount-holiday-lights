---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Holiday Lighting Services"
  description="Roofline and second-story LED installation, tree and landscape lighting, season-long maintenance, take-down and off-season storage — all included in one estimate."
>
  <section class="section section--white">
    <div class="wrap">
      <p class="hero-eyebrow" style="color: var(--sign-red);">Services</p>
      <h1>Premium LED, installed and maintained.</h1>
      <p style="max-width: 640px; font-size: 1.05rem;">
        Every price includes premium LED product, installation, season-long maintenance, take-down and storage. One call books the whole season.
      </p>
    </div>
  </section>

  <section class="section section--cream">
    <div class="wrap">
      <div class="card-grid">
        <div class="card">
          <div class="photo-block"><span class="photo-block-label">Roofline install</span></div>
          <div class="card-body">
            <h3>Roofline lighting</h3>
            <p>Clean, commercial-grade LED along the roofline, priced per linear foot and quoted on site.</p>
          </div>
        </div>
        <div class="card">
          <div class="photo-block"><span class="photo-block-label">Second-story install</span></div>
          <div class="card-body">
            <h3>Second-story lighting</h3>
            <p>Tall rooflines are common in North Dallas — we bring the right equipment and crew for a safe, clean install.</p>
          </div>
        </div>
        <div class="card">
          <div class="photo-block"><span class="photo-block-label">Trees &amp; landscape lighting</span></div>
          <div class="card-body">
            <h3>Trees &amp; landscape lighting</h3>
            <p>Trunk-wrapped trees, columns and landscape accents. Every property is different, so these are quoted after a walkthrough.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap">
      <h2>What's included in every install</h2>
      <div class="card-grid">
        <div class="card">
          <div class="card-body">
            <h3>Design &amp; layout</h3>
            <p>We walk the property with you and plan the layout before anything goes up.</p>
          </div>
        </div>
        <div class="card">
          <div class="card-body">
            <h3>Commercial-grade LED</h3>
            <p>Premium product, not the extension-cord version — built to run all season.</p>
          </div>
        </div>
        <div class="card">
          <div class="card-body">
            <h3>Professional installation</h3>
            <p>Hung clean, powered up, and checked before we leave the property.</p>
          </div>
        </div>
        <div class="card">
          <div class="card-body">
            <h3>Season-long maintenance</h3>
            <p>A bulb goes out in January, we come back — no extra charge.</p>
          </div>
        </div>
        <div class="card">
          <div class="card-body">
            <h3>Take-down</h3>
            <p>We're back out in January to take everything down and pull the sign.</p>
          </div>
        </div>
        <div class="card">
          <div class="card-body">
            <h3>Off-season storage</h3>
            <p>We store your lights for you, so next season starts with one phone call instead of a garage search.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--evergreen">
    <div class="wrap" style="text-align:center;">
      <h2>Estimates are free and good for 30 days.</h2>
      <div class="hero-actions" style="justify-content:center; margin-top: 16px;">
        <a href="/contact" class="btn btn--primary">Request a free estimate</a>
        <a href="/service-area" class="btn btn--outline">Check your neighborhood</a>
      </div>
    </div>
  </section>
</BaseLayout>
est2
