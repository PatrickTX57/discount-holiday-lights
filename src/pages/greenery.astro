---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Lit Wreaths, Garland &amp; Bows"
  description="Premium LED lit wreaths in 24, 36 and 48 inch, 9-foot lit garland, bows and other decorations — hung, powered and removed by us."
>
  <section class="section section--white">
    <div class="wrap">
      <p class="hero-eyebrow" style="color: var(--sign-red);">Lit Greenery</p>
      <h1>Wreaths, garland and bows.</h1>
      <p style="max-width: 640px; font-size: 1.05rem;">
        Premium LED on full-bodied greenery. Hung, powered and removed by us — no ladders, no storage bin in your attic.
      </p>
    </div>
  </section>

  <section class="section section--cream">
    <div class="wrap">
      <div class="card-grid">
        <div class="card">
          <div class="photo-block"><span class="photo-block-label">Lit wreath &middot; 24&Prime; / 36&Prime; / 48&Prime;</span></div>
          <div class="card-body">
            <h3>Lit wreaths</h3>
            <p>Premium LED on full-bodied greenery, available in 24&Prime;, 36&Prime; and 48&Prime;.</p>
            <div class="badge-list">
              <span class="badge">24&Prime;</span>
              <span class="badge">36&Prime;</span>
              <span class="badge">48&Prime;</span>
            </div>
          </div>
        </div>
        <div class="card">
          <div class="photo-block"><span class="photo-block-label">9&prime; lit garland</span></div>
          <div class="card-body">
            <h3>Lit garland</h3>
            <p>9-foot runs of lit garland for entries, railings and mantels — hung and powered by us.</p>
          </div>
        </div>
        <div class="card">
          <div class="photo-block"><span class="photo-block-label">Bows &amp; decorations</span></div>
          <div class="card-body">
            <h3>Bows &amp; decorations</h3>
            <p>Finishing touches to match the rest of the install, all premium quality.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--red">
    <div class="wrap" style="text-align:center;">
      <h2>All products are premium quality LED.</h2>
      <p style="max-width: 500px; margin: 0 auto 24px;">Every price includes installation, season-long upkeep, take-down and storage.</p>
      <a href="/contact" class="btn btn--outline">Get a free estimate</a>
    </div>
  </section>
</BaseLayout>
est
