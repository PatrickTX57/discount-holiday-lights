---
// Shared lead-capture form for paid-traffic landing pages.
// Same Web3Forms endpoint/access key as the rest of the site, tagged with a
// distinct "subject" per source so leads are identifiable in the inbox.
//
// The third field defaults to "Address or neighborhood" (used by the
// Facebook Ads page). The Google Ads page overrides it to a Zip Code field
// via the location* props below — pass them to swap the field on any page
// without touching the others.
interface Props {
  source: string; // "Google Ads Landing Page" | "Facebook Ads Landing Page"
  formId: string;
  ctaLabel?: string;
  locationLabel?: string;
  locationName?: string;
  locationPlaceholder?: string;
  locationInputMode?: string;
  locationPattern?: string;
  locationMaxLength?: number;
}
const {
  source,
  formId,
  ctaLabel = 'Get My Free Estimate',
  locationLabel = 'Address or neighborhood',
  locationName = 'address',
  locationPlaceholder = '123 Main St, Plano',
  locationInputMode,
  locationPattern,
  locationMaxLength,
} = Astro.props;
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '';
---
<div class="lp-form-card">
  <h3>Get Your Free Estimate</h3>
  <p class="lp-form-note">No obligation. We'll follow up to schedule a walkthrough — estimates are good for 30 days.</p>
  <form
    id={formId}
    action="https://api.web3forms.com/submit"
    method="POST"
    class="lp-form-grid"
  >
    <input type="hidden" name="access_key" value={accessKey} />
    <input type="hidden" name="subject" value={`New lead — ${source}`} />
    <input type="hidden" name="lead_source" value={source} />
    <input type="checkbox" name="botcheck" style="display:none;" />

    <div>
      <label for={`${formId}-name`}>Name</label>
      <input type="text" id={`${formId}-name`} name="name" required />
    </div>
    <div>
      <label for={`${formId}-phone`}>Phone</label>
      <input type="tel" id={`${formId}-phone`} name="phone" required />
    </div>
    <div>
      <label for={`${formId}-location`}>{locationLabel}</label>
      <input
        type="text"
        id={`${formId}-location`}
        name={locationName}
        placeholder={locationPlaceholder}
        inputmode={locationInputMode}
        pattern={locationPattern}
        maxlength={locationMaxLength}
        required
      />
    </div>

    <div class="h-captcha" data-captcha="true"></div>

    <button type="submit" class="lp-btn">{ctaLabel}</button>
    <p class="lp-form-status" id={`${formId}-status`}></p>
  </form>
</div>

<script define:vars={{ formId }}>
  const form = document.getElementById(formId);
  const status = document.getElementById(`${formId}-status`);
  if (form) {
    form.addEventListener('submit', (e) => {
      const captchaResponse = form.querySelector('textarea[name="h-captcha-response"]');
      if (!captchaResponse || !captchaResponse.value) {
        e.preventDefault();
        if (status) status.textContent = 'Please complete the captcha before submitting — thanks!';
      } else if (typeof window.gtag_report_conversion === 'function') {
        // Defined only on the Google Ads landing page (see google-ads.astro's
        // head-extra block) — a no-op here on the Facebook Ads page, so leads
        // from that page never get counted as Google Ads conversions.
        window.gtag_report_conversion();
      }
    });
  }
</script>
